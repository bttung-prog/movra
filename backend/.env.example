PORT=5000
NODE_ENV=development

MONGODB_CONNECTION_STR=mongodb://localhost:27017/tms?replicaSet=rs0

BCRYPT_SALT_ROUNDS=12

JWT_ACCESS_SECRET=YOUR_ACCESS_SECRET
JWT_REFRESH_SECRET=YOUR_REFRESH_SECRET
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=30d
REFRESH_TOKEN_EXPIRES_MS=2592000000

# Frontend origin; browser requests must use credentials: "include"
CLIENT_ORIGIN=http://localhost:5173
# Set to "none" only if frontend and API are cross-site; production requires HTTPS
REFRESH_TOKEN_COOKIE_SAME_SITE=lax
# Optional when frontend and API use separate subdomains
# REFRESH_TOKEN_COOKIE_DOMAIN=example.com

# Storage Provider (local | cloudinary | s3)
STORAGE_TYPE=local
